{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      "entry": ["scripts/*.mjs"],
      "project": ["scripts/**/*.mjs"]
    },
    "packages/electron": {
      "entry": ["preload.cjs", "scripts/*.mjs"],
      "project": ["*.{js,cjs}", "lib/**/*.js", "scripts/**/*.mjs"]
    },
    "packages/core": {
      "entry": ["js/demo/loader.js", "js/renderer.js", "js/alarmModal.js", "js/mini.js"],
      "project": ["js/**/*.js"]
    },
    "packages/pwa": {
      "entry": ["service-worker.js", "platform/*.js", "scripts/*.mjs"],
      "project": ["**/*.{js,mjs}"]
    }
  }
}
